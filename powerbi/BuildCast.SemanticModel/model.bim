{
  "name": "BuildCast",
  "compatibilityLevel": 1550,
  "model": {
    "culture": "en-GB",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "tables": [
      {
        "name": "dim_job",
        "columns": [
          {
            "name": "job_ref",
            "dataType": "string",
            "sourceColumn": "job_ref",
            "summarizeBy": "none"
          },
          {
            "name": "project_name",
            "dataType": "string",
            "sourceColumn": "project_name",
            "summarizeBy": "none"
          },
          {
            "name": "client",
            "dataType": "string",
            "sourceColumn": "client",
            "summarizeBy": "none"
          },
          {
            "name": "sector",
            "dataType": "string",
            "sourceColumn": "sector",
            "summarizeBy": "none"
          },
          {
            "name": "region",
            "dataType": "string",
            "sourceColumn": "region",
            "summarizeBy": "none"
          },
          {
            "name": "work_type",
            "dataType": "string",
            "sourceColumn": "work_type",
            "summarizeBy": "none"
          },
          {
            "name": "gia_m2",
            "dataType": "double",
            "sourceColumn": "gia_m2",
            "summarizeBy": "sum"
          },
          {
            "name": "floors",
            "dataType": "int64",
            "sourceColumn": "floors",
            "summarizeBy": "none"
          },
          {
            "name": "spec",
            "dataType": "string",
            "sourceColumn": "spec",
            "summarizeBy": "none"
          },
          {
            "name": "package",
            "dataType": "string",
            "sourceColumn": "package",
            "summarizeBy": "none"
          },
          {
            "name": "sprinklers",
            "dataType": "int64",
            "sourceColumn": "sprinklers",
            "summarizeBy": "none"
          },
          {
            "name": "occupied",
            "dataType": "int64",
            "sourceColumn": "occupied",
            "summarizeBy": "none"
          },
          {
            "name": "offsite_pct",
            "dataType": "double",
            "sourceColumn": "offsite_pct",
            "summarizeBy": "none"
          },
          {
            "name": "start_date",
            "dataType": "dateTime",
            "sourceColumn": "start_date",
            "summarizeBy": "none",
            "formatString": "Short Date"
          },
          {
            "name": "planned_weeks",
            "dataType": "int64",
            "sourceColumn": "planned_weeks",
            "summarizeBy": "none"
          },
          {
            "name": "tender_electrical_hours",
            "dataType": "int64",
            "sourceColumn": "tender_electrical_hours",
            "summarizeBy": "sum"
          },
          {
            "name": "tender_mechanical_hours",
            "dataType": "int64",
            "sourceColumn": "tender_mechanical_hours",
            "summarizeBy": "sum"
          },
          {
            "name": "tender_value_gbp",
            "dataType": "double",
            "sourceColumn": "tender_value_gbp",
            "summarizeBy": "sum"
          },
          {
            "name": "status",
            "dataType": "string",
            "sourceColumn": "status",
            "summarizeBy": "none"
          },
          {
            "name": "bc_job_no",
            "dataType": "string",
            "sourceColumn": "bc_job_no",
            "summarizeBy": "none"
          },
          {
            "name": "start_year",
            "dataType": "int64",
            "sourceColumn": "start_year",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "dim_job",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"dim_job.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Promoted, {{\"job_ref\", type text}, {\"project_name\", type text}, {\"client\", type text}, {\"sector\", type text}, {\"region\", type text}, {\"work_type\", type text}, {\"gia_m2\", type number}, {\"floors\", Int64.Type}, {\"spec\", type text}, {\"package\", type text}, {\"sprinklers\", Int64.Type}, {\"occupied\", Int64.Type}, {\"offsite_pct\", type number}, {\"start_date\", type date}, {\"planned_weeks\", Int64.Type}, {\"tender_electrical_hours\", Int64.Type}, {\"tender_mechanical_hours\", Int64.Type}, {\"tender_value_gbp\", type number}, {\"status\", type text}, {\"bc_job_no\", type text}, {\"start_year\", Int64.Type}}, \"en-GB\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Labour Hours",
            "expression": "SUM ( fact_labour[hours] )",
            "formatString": "#,0"
          },
          {
            "name": "Floor Area m2",
            "expression": "SUM ( dim_job[gia_m2] )",
            "formatString": "#,0"
          },
          {
            "name": "Labour Hours per m2",
            "expression": "CALCULATE ( DIVIDE ( [Labour Hours], [Floor Area m2] ), dim_job[status] = \"Completed\" )",
            "formatString": "0.00"
          },
          {
            "name": "Tender Labour Hours",
            "expression": "SUM ( dim_job[tender_electrical_hours] ) + SUM ( dim_job[tender_mechanical_hours] )",
            "formatString": "#,0"
          },
          {
            "name": "Actual vs Tender %",
            "expression": "VAR actual = CALCULATE ( [Labour Hours], dim_job[status] = \"Completed\" )\nVAR tender = CALCULATE ( [Tender Labour Hours], dim_job[status] = \"Completed\" )\nRETURN DIVIDE ( actual - tender, tender )",
            "formatString": "0.0%"
          },
          {
            "name": "Jobs Completed",
            "expression": "CALCULATE ( DISTINCTCOUNT ( dim_job[job_ref] ), dim_job[status] = \"Completed\" )",
            "formatString": "#,0"
          },
          {
            "name": "Jobs Over Tender 10%",
            "expression": "VAR jobs = ADDCOLUMNS ( CALCULATETABLE ( VALUES ( dim_job[job_ref] ), dim_job[status] = \"Completed\" ), \"ratio\", [Actual vs Tender %] )\nRETURN DIVIDE ( COUNTROWS ( FILTER ( jobs, [ratio] > 0.10 ) ), COUNTROWS ( jobs ) )",
            "formatString": "0%"
          },
          {
            "name": "Material Spend GBP",
            "expression": "SUM ( fact_material[cost_gbp] )",
            "formatString": "\u00a3#,0"
          },
          {
            "name": "Labour Cost GBP",
            "expression": "SUM ( fact_cost[cost_gbp] )",
            "formatString": "\u00a3#,0"
          }
        ]
      },
